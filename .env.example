# Password for the /admin page
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string
# Optional: ISO currency code for prices (default NGN)
# NEXT_PUBLIC_CURRENCY=NGN
# Optional: override the WhatsApp number (digits only, international format). Default is set in src/lib/brand.ts.
# NEXT_PUBLIC_WHATSAPP_NUMBER=2347080175599
# Optional: folder for materials.json and uploaded images (default ./data)
# DATA_DIR=./data
